# Consumed by docker-compose.yml at the repo root. Copy to .env and adjust —
# no real credentials belong in this file or in the copy you create locally
# from it beyond throwaway local-dev values.

POSTGRES_DB=api
POSTGRES_USER=api
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000
REVERB_PORT=8080

# The port the Nuxt panel actually runs on (npm run dev, on the host — not
# a container in dev, see DECISIONS.md). This must match whatever port the
# panel is really serving on: docker-compose.yml uses it to build api/'s
# SANCTUM_STATEFUL_DOMAINS and CORS_ALLOWED_ORIGINS, so a mismatch here
# fails closed on login (CORS/CSRF rejection), not with an obvious error.
# Change this if 3000 is already taken on your machine, and start the
# panel with a matching `PORT=<value> npm run dev`.
PANEL_PORT=3000

# Host address other devices on your network use to reach this machine.
# Leave as localhost for a machine-local setup.
LAN_HOST=localhost

# Public production server address used by docker-compose.prod.yml and production mobile builds.
SERVER_HOST=203.0.113.10
SERVER_SCHEME=https
PROD_API_PORT=8000
APP_KEY=
REVERB_APP_ID=
REVERB_APP_SECRET=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
REVERB_APP_KEY=
