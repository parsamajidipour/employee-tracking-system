# Local development defaults. Production values are generated securely on the
# VPS by scripts/deploy.sh and are never committed.

POSTGRES_DB=api
POSTGRES_USER=api
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000
REVERB_PORT=8080

# The port the Nuxt panel actually runs on (npm run dev, on the host — not
# a container in dev, see DECISIONS.md). This must match whatever port the
# panel is really serving on: docker-compose.yml uses it to build api/'s
# SANCTUM_STATEFUL_DOMAINS and CORS_ALLOWED_ORIGINS, so a mismatch here
# fails closed on login (CORS/CSRF rejection), not with an obvious error.
# Change this if 3000 is already taken on your machine, and start the
# panel with a matching `PORT=<value> npm run dev`.
PANEL_PORT=3000

# Host address other devices on your network use to reach this machine.
# Leave as localhost for a machine-local setup.
LAN_HOST=localhost

# Public production domain used by Caddy, the panel, and production mobile builds.
# Create an A record for this host pointing to the VPS before deployment.
SERVER_HOST=manaba.mouj.om
SERVER_SCHEME=https
APP_KEY=
REVERB_APP_ID=
REVERB_APP_SECRET=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@inspection.local
SEED_ADMIN_PASSWORD=
REVERB_APP_KEY=
SESSION_SECURE_COOKIE=true
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse

# Google Maps JavaScript API key used by the panel (both map pages fail closed
# without it). Maps JavaScript API must be enabled and billing active on the
# Google Cloud project. Never commit a real value here.
GOOGLE_MAPS_API_KEY=
