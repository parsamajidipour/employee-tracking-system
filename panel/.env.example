# The api/ origin as seen by the browser — must also be listed in api/'s
# SANCTUM_STATEFUL_DOMAINS and CORS_ALLOWED_ORIGINS.
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Reverb connection details as seen by the browser, for the live map's
# WebSocket subscription (Laravel Echo). REVERB_APP_KEY is the public half
# of api/.env's Reverb credentials (safe to expose — REVERB_APP_SECRET never
# leaves the server); HOST/PORT/SCHEME must match api/.env's REVERB_HOST/
# REVERB_PORT/REVERB_SCHEME as reachable from the browser (the host-mapped
# port, not the container-internal one).
NUXT_PUBLIC_REVERB_APP_KEY=
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_SCHEME=http

# Google Maps JavaScript API key (Maps JavaScript API enabled, billing active
# on the Google Cloud project). Both map pages fail closed with a visible
# error if this is missing. Never commit a real key here.
NUXT_PUBLIC_GOOGLE_MAPS_API_KEY=
